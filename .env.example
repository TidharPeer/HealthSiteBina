# מפתח Web3Forms לשמירת לידים מהטופס. המפתח של בינה כבר מוטמע בקוד
# (src/config/people.ts), אז אין חובה להגדיר כאן דבר — המשתנה קיים רק
# כדי לאפשר החלפת מפתח בלי לגעת בקוד.
# מקומית: להעתיק לקובץ .env.local. בפרודקשן: Environment Variable ב-Vercel.
VITE_WEB3FORMS_ACCESS_KEY=

# מזהה מדידה של Google Analytics 4 (Admin → Data Streams → Measurement ID).
# בלי המזהה סקריפט GA לא נטען כלל, כך שסביבת פיתוח לא מזהמת את הנתונים.
VITE_GA_MEASUREMENT_ID=
